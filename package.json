{
  "name": "piko",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "pnpm --filter @piko/web dev",
    "dev:compiler": "pnpm --filter @piko/compiler dev",
    "setup:arduino": "node scripts/setup-arduino.mjs",
    "build": "pnpm prepare:wasm && pnpm --filter @piko/web build",
    "typecheck": "tsc --noEmit && pnpm --filter @piko/web typecheck",
    "test": "pnpm test:unit && pnpm test:wasm",
    "test:unit": "vitest run --exclude tests/firmware.test.ts",
    "deploy:web": "pnpm build && pnpm --filter @piko/web exec wrangler deploy",
    "check:compiler-image": "node scripts/check-compiler-image.mjs",
    "prepare:wasm": "node scripts/prepare-browser-compiler.mjs",
    "dev:wasm": "pnpm dev",
    "build:wasm": "pnpm build",
    "test:wasm": "pnpm prepare:wasm && PIKO_TEST_COMPILER=browser vitest run tests/firmware.test.ts tests/browser-compiler.test.ts",
    "dev:native": "VITE_COMPILER=native node scripts/dev-native.mjs",
    "dev:backend": "pnpm --filter @piko/backend dev",
    "setup:backend": "node scripts/setup-backend.mjs",
    "build:compiler": "pnpm --filter @piko/compiler build",
    "deploy:backend": "pnpm --filter @piko/backend deploy",
    "check:projects": "node scripts/check-project-service.mjs",
    "test:native": "vitest run tests/firmware.test.ts"
  },
  "devDependencies": {
    "@convex-dev/better-auth": "0.13.0",
    "@piko/compile-contract": "workspace:*",
    "@piko/project-model": "workspace:*",
    "@tanstack/react-router": "^1.170.46",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "better-auth": "~1.7.25",
    "convex": "^1.50.0",
    "convex-test": "^0.0.71",
    "effect": "4.1.2",
    "jsdom": "^31.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
