{
  "name": "piko",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "pnpm --filter @piko/web dev",
    "dev:compiler": "pnpm --filter @piko/compiler dev",
    "setup:arduino": "node scripts/setup-arduino.mjs",
    "build": "pnpm --filter @piko/compiler build && pnpm --filter @piko/web build",
    "typecheck": "tsc --noEmit && pnpm --filter @piko/web typecheck",
    "test": "vitest run",
    "test:unit": "vitest run --exclude tests/firmware.test.ts",
    "deploy:web": "pnpm --filter @piko/web deploy",
    "check:compiler-image": "node scripts/check-compiler-image.mjs",
    "prepare:wasm": "node scripts/prepare-browser-compiler.mjs",
    "dev:wasm": "pnpm prepare:wasm && pnpm --filter @piko/web dev:wasm",
    "build:wasm": "pnpm prepare:wasm && pnpm --filter @piko/web build:wasm",
    "test:wasm": "pnpm prepare:wasm && PIKO_TEST_COMPILER=browser vitest run tests/firmware.test.ts tests/browser-compiler.test.ts"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^31.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "vite": "^8.3.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "effect": "4.1.2",
    "@piko/compile-contract": "workspace:*",
    "@tanstack/react-router": "^1.170.46"
  }
}
